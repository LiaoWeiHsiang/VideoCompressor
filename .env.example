# Your Apple Developer Team ID, used for code signing.
# Find it at https://developer.apple.com/account under Membership details,
# or run:  security find-identity -v -p codesigning
DEVELOPMENT_TEAM=XXXXXXXXXX

# Optional. With more than one iPhone attached, name the one to build for — otherwise the
# first paired device wins, which is rarely the one you meant.
#   xcrun devicectl list devices
# DEVICE_ID=00000000-000000000000000
